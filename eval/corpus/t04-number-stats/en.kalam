# Task 4: count, sum, average, minimum and maximum of numbers given as text.
# Runtime parsing accepts ASCII and Arabic-Indic digits (spec 6.2). The average is printed
# from Int tenths, so no Float is ever shown.
fn parse_all(text: String) -> List[Int]:
    var numbers: List[Int] = []
    for word in text.split(" "):
        match word.to_int():
            case Ok(n):
                numbers = numbers.append(n)
            case Err(_):
                print("skipped \"{word}\"")
    return numbers

fn main():
    let numbers = parse_all("12 ٧ 30 ١٠٠ -5 x7 8 ٤٢ 3.5")
    if numbers.is_empty():
        print("no numbers")
        return
    var total = 0
    var smallest = numbers[0]
    var largest = numbers[0]
    for n in numbers:
        total += n
        if n < smallest:
            smallest = n
        if n > largest:
            largest = n
    let count = numbers.len()
    let tenths = total * 10 // count
    print("count = {count}")
    print("sum = {total}")
    print("average = {tenths // 10}.{tenths % 10} (truncated to one decimal)")
    print("min = {smallest}")
    print("max = {largest}")
