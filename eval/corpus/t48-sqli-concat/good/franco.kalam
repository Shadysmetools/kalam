# Task 48 (good twin): the same lookup with sql"..." holes. Each payload stays data.
hat std/sql.{nafso, Db, DbError}

@derive(Row)
haykal Customer:
    id: adad
    name: nass

dala find_by_city(db: Db, city: nass) -> natiga[qayma[Customer], DbError]:
    rag3 db.all(sql"SELECT id, name FROM customers WHERE city = {city} ORDER BY id")

dala ra2isi(world: donya) -> natiga[(), AnyError]:
    khali db = sql.sqlite(world.fs, "shop.db")?
    khali _ = db.exec(sql"CREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT, city TEXT)")?
    lekol (name, city) fi [("Amal", "Cairo"), ("Badr", "Giza"), ("Camelia", "Cairo")]:
        khali _ = db.exec(sql"INSERT INTO customers (name, city) VALUES ({name}, {city})")?
    lekol city fi ["Cairo", "Cairo' OR '1'='1", "Giza'; DROP TABLE customers; --"]:
        khali found = find_by_city(db, city)?
        ektb("{city}: {found.len()} customer(s)")
    lekol customer fi find_by_city(db, "Cairo")?:
        ektb("- {customer.name}")
    rag3 naga7(())
