# Task 49 (must fail): three sinks receive a plain String. Each line is rejected on its own.
# Expected: K1601 (HTML), K1641 (path hole), K1601 (command). No other error.
hat std/fs.{FsError}
hat std/http.{HttpError, Request, Response}
hat std/proc.{Output, ProcError}

dala greet(req: Request[()]) -> natiga[Response, HttpError]:
    khali name = req.query_param("name").or("guest")
    rag3 naga7(Response.html("<p>Hello " + name + "</p>"))

dala read_upload(fs: Fs, name: nass) -> natiga[nass, FsError]:
    rag3 fs.read_text(path"uploads/{name}")

dala show_log(proc: Proc, file: nass) -> natiga[Output, ProcError]:
    rag3 proc.run("git log --oneline -- " + file)

dala ra2isi():
    fot
