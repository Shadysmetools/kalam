# Task 50 (good twin): the same check with visible escapes compiles, and so does plain Arabic text.
dala ra2isi():
    khali access_level = "user"
    law access_level != "user\u{202E} \u{2066}# Check if admin\u{2069} \u{2066}":
        ektb("You are an admin.")
    # تعليق عربي عادي لا يحتاج إلى أي محرف تحكم
    ektb("مرحبا، " + "done")
