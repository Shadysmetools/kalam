# Task 9: guess-the-number with a seeded RNG. The seed comes from standard input: bad lines are
# rejected and the loop reads again. A binary-search player then guesses the secret.
# Rand.seeded's algorithm is not specified, so nothing printed depends on the drawn number:
# the output shows determinism (same seed, same secret) and that 7 guesses always suffice.
# Assumed API (spec gap, see task.toml): Stdin.read_line() -> Option[String];
# Rand.seeded(n).int(range) -> Int.
دالة read_seed(stdin: Stdin) -> اختياري[عدد]:
    لكل attempt في 1..=5:
        ليكن text = stdin.read_line()؟
        حسب text.trim().to_int():
            عندما نجاح(seed) إذا seed > 0:
                اطبع("attempt {attempt}: seed accepted")
                أرجع موجود(seed)
            عندما نجاح(_):
                اطبع("attempt {attempt}: the seed must be positive")
            عندما فشل(_):
                اطبع("attempt {attempt}: \"{text}\" is not a number")
    أرجع لا_شيء

دالة guesses_needed(secret: عدد) -> عدد:
    متغير lowest = 1
    متغير highest = 100
    متغير tries = 0
    متغير found = خطأ
    طالما ليس found:
        ليكن guess = (lowest + highest) // 2
        tries += 1
        إذا guess < secret:
            lowest = guess + 1
        وإلا إذا guess > secret:
            highest = guess - 1
        وإلا:
            found = صح
    أرجع tries

دالة رئيسي(world: عالم):
    حسب read_seed(world.stdin):
        عندما لا_شيء:
            اطبع("no seed given")
        عندما موجود(seed):
            ليكن secret = Rand.seeded(seed).int(1..=100)
            ليكن replay = Rand.seeded(seed).int(1..=100)
            اطبع(إذا secret == replay: "same seed, same secret" وإلا: "not deterministic")
            اطبع(إذا secret >= 1 و secret <= 100: "secret is in 1..=100" وإلا: "out of range")
            ليكن tries = guesses_needed(secret)
            اطبع(إذا tries <= 7: "found within 7 guesses" وإلا: "needed more than 7 guesses")
    متغير worst = 0
    لكل candidate في 1..=100:
        ليكن needed = guesses_needed(candidate)
        إذا needed > worst:
            worst = needed
    اطبع("worst case over 1..=100: {worst} guesses")
