# Task 12: records, sum types and exhaustive match. Every printed number is an Int.
تعداد Shape:
    Rect(width: عدد، height: عدد)
    Square(side: عدد)
    Triangle(base: عدد، height: عدد)
    Empty

هيكل Item:
    label: نص
    shape: Shape
    count: عدد = 1

دالة area(shape: Shape) -> عدد:
    أرجع حسب shape:
        عندما .Rect(w، h): w * h
        عندما .Square(s): s * s
        عندما .Triangle(b، h): b * h // 2
        عندما .Empty: 0

دالة describe(shape: Shape) -> نص:
    أرجع حسب shape:
        عندما .Rect(w، h) إذا w == h: "square-ish rect"
        عندما .Rect(_، _) | .Square(_): "four sides"
        عندما .Triangle(..): "three sides"
        عندما .Empty: "nothing"

دالة رئيسي():
    ليكن items = [
        Item(label: "door"، shape: .Rect(width: 90، height: 210))،
        Item(label: "tile"، shape: .Square(side: 30)، count: 12)،
        Item(label: "sail"، shape: .Triangle(base: 5، height: 7))،
        Item(label: "box"، shape: .Rect(width: 4، height: 4))،
        Item(label: "gap"، shape: .Empty)،
    ]
    متغير total = 0
    لكل item في items:
        ليكن one = area(item.shape)
        total += one * item.count
        اطبع("{item.label}: {describe(item.shape)}, area {one} x{item.count}")
    اطبع("total area: {total}")
    ليكن bigger = items[1].with(count: 20)
    اطبع("{bigger.label} now x{bigger.count}, original x{items[1].count}")
    ليكن same = items[0] == Item(label: "door"، shape: .Rect(width: 90، height: 210))
    اطبع(إذا same: "equal records" وإلا: "different records")
