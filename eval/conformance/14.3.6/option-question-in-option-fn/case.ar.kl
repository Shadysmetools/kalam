دالة head_plus_one(xs: قائمة[عدد]) -> اختياري[عدد]:
    ليكن n = xs.get(0)؟
    أرجع موجود(n + 1)

دالة head(xs: قائمة[عدد]) -> نتيجة[عدد، نص]:
    ليكن n = xs.get(0).ok_or("empty")؟
    أرجع نجاح(n)

دالة رئيسي():
    ليكن a = head_plus_one([2])
    ليكن _ = head([2])
    حسب a:
        عندما موجود(n):
            اطبع("{n}")
        عندما لا_شيء:
            اطبع("none")
