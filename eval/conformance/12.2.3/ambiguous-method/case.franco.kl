sefa Named:
    dala label(nafso) -> nass

sefa Tagged:
    dala label(nafso) -> nass

haykal Item:
    id: adad

naffez Item ka Named:
    dala label(nafso) -> nass => "named"

naffez Item ka Tagged:
    dala label(nafso) -> nass => "tagged"

dala ra2isi():
    khali item = Item(id: 1)
    ektb(item.label())
