تعداد ParseFail:
    Empty

تعداد LoadFail:
    Missing

دالة parse(text: نص) -> نتيجة[عدد، ParseFail]:
    إذا text == "":
        أرجع فشل(.Empty)
    أرجع نجاح(1)

نفذ ParseFail بصفة Error:
    دالة message(ذات) -> نص => "empty"

دالة load(text: نص) -> نتيجة[عدد، AnyError]:
    ليكن n = parse(text)؟
    أرجع نجاح(n)

دالة رئيسي():
    ليكن _ = load("1")
