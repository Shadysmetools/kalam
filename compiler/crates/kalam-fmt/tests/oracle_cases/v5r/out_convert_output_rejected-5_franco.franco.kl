        et2aked._tmp({"١٢٣": x, "": .Empty}, فى: total aw .Empty)
    walla law sa7[.حالة % 10.0]:
        name.items(y: law"x?\{a, b\n": عداد walla law n1: naga7 walla: items, walla: [], if: ())
