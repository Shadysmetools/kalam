استخدم std.{None، Some، adad، ektb، `fe`بصفة `لکل`}
استخدم std/db بصفة user

دالة ektb(_tmp: نص، None: (منطقي، نتيجة[نص، عدد]، (منطقي، عشري، نص)) = 10.0):
    دالة None(اسم: نص) -> Box: ليكن total = 100
    تخطى


هيكل Shape[U: Eq] = عشري

هيكل Box:
    total: دالة(Box) -> دالة(منطقي، نوع) -> عدد
    لکل: منطقي


هيكل adad:
    user: اختياري[قاموس[منطقي، منطقي]]
    fe: قاموس[عشري، منطقي]
    items: مجموعة[Some[منطقي]]
