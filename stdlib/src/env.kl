# std/env (spec §16.1, §18.1, §20.1): methods of the prelude capability `Env`.

impl Env:
    ## The variable's value, or `None` when it is unset. A literal key that looks secret
    ## (`*_KEY`, `*_SECRET`, `*_TOKEN`, `PASSWORD`) is K1503: use `secret`.
    @builtin
    export fn get(self, key: String) -> Option[String] => panic("builtin")

    ## The variable's value as a `Secret`, or `None` when it is unset.
    @builtin
    export fn secret(self, key: String) -> Option[Secret[String]] => panic("builtin")

    ## An `Env` that can read only `keys`.
    @builtin
    export fn only(self, keys: List[String]) -> Env => panic("builtin")
